# Copy this file to .env and fill in local values.

# Google Maps Platform API key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google OAuth 2.0 client ID (do not put a client secret in a mobile app)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# Backend local database and token signing configuration
DB_URL=jdbc:postgresql://localhost:5432/snaphere
DB_USERNAME=snaphere
DB_PASSWORD=your_database_password
SNAPHERE_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
SNAPHERE_TERMS_VERSION=2026-08-01
