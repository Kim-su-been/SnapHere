# Copy this file to .env and fill in local values.

# Google Maps Platform API key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google OAuth 2.0 client ID (do not put a client secret in a mobile app)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id

# Korea Tourism Organization TourAPI
TOUR_API_SERVICE_KEY=your_tour_api_service_key

# PostgreSQL 16 + PostGIS 3
DATABASE_URL=jdbc:postgresql://localhost:5432/snaphere
DATABASE_USERNAME=snaphere
DATABASE_PASSWORD=snaphere

# Redis view counter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PEM keys encoded as a single line with literal \n separators.
# If omitted in a local profile, an ephemeral key is generated at startup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=snaphere-api
ADMIN_GOOGLE_SUBJECTS=
